{
  "issues": {
    "write_failed_repeated": {
      "title": "{unit_name} is not responding to commands",
      "description": "The integration has failed to confirm {threshold} consecutive writes to **{unit_name}**.\n\nLikely causes:\n- A `Lock *` switch is enabled for that unit (Settings → Devices → {unit_name} → Configuration).\n- An alarm is active (check the unit's `Alarm code` and `Alarm description` sensors).\n- The compressor is in a 3-min protection cooldown after a recent stop.\n- The outdoor unit is at its capacity limit or in startup.\n- The wire controller has the unit in a different state.\n\nThis issue clears automatically the next time a write succeeds."
    }
  },
  "config": {
