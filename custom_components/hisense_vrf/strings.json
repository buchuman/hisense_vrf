          "on_retry": "Keep retrying power-on in the background"
        },
        "data_description": {
          "host": "IP address or hostname of the i-Modkit gateway.",
          "port": "Modbus TCP port (default 502).",
          "verify_delay_s": "Seconds to wait after a write before reading back the unit state.",
          "verify_retries": "How many additional reads to attempt if the value does not match yet.",
          "off_pending_ttl_s": "While a unit is off, accumulated UI changes are kept for this many seconds before being discarded. Press ON within that window to flush them in one bundled write.",
          "polling_enabled": "When enabled, the integration reads each unit on a fixed cadence so the UI reflects external changes.",
          "poll_interval_s": "Pause between polling cycles. 0 means cycles run back-to-back.",
          "poll_spacing_s": "Pause between consecutive unit reads inside a cycle. Leave at 0 unless you need to throttle.",
          "poll_gateway_every_n_cycles": "Read the gateway state and outdoor unit only every N cycles (these change slowly).",
          "connect_timeout_s": "Max seconds to wait for the initial connection and scan at startup. If exceeded, Home Assistant will retry with backoff instead of blocking the bootstrap.",
          "on_edge_force": "When a power-on is not reflected on the first try, the retry writes run_stop=0 first to force a fresh 0→1 transition before re-sending the ON command. Works around units that an IR remote turned off, leaving the gateway's run state out of sync. Off by default — prod evidence showed it doesn't help; the background retry below does.",
          "on_retry": "Only the power-on command intermittently fails (off/temp/mode never do). When a power-on isn't confirmed, a background task keeps re-sending it for a few minutes until the unit turns on — or stops early if the unit turns on by any means, its state changes externally, or you send another command. Recommended on."
        }
      },
      "reconfigure": {
        "title": "Reconfigure Hisense VRF gateway",
        "description": "Change the host or port of the i-Modkit gateway. All other options (verification, polling) are preserved.",
